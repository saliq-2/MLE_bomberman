# The Dockerfile ends with `COPY . .`, so everything not excluded here is sent
# to the daemon as build context and baked into the image. Without this file
# that included logs_by_tag/, which is 9.5 GB of per-run game logs in this
# checkout — the build spent minutes transferring context before it had
# installed anything, and the resulting image would have carried all of it.
#
# None of the excluded paths are needed to run an agent: the game only needs
# the framework modules and agent_code/.

# Per-run game logs (large; regenerated by re-running an evaluation).
#
# Note `logs/*` and not `logs/`: environment.py opens {log_dir}/game.log with a
# FileHandler and never creates the directory, so the directory itself must
# survive into the image or the game dies before the first round with
# FileNotFoundError. Only its contents are excluded.
logs/*
logs_by_tag/
logs_*/
logs_*.txt

# Version control and editor state
.git/
.gitignore
.vscode/
.idea/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Build artifacts and local outputs
final-project-agent-code.zip
docker_test_output.txt
docker_game.log
docker_agent_logs/
replays/
screenshots/

# Course handout
final_project*.pdf

# macOS metadata
.DS_Store
._*

# Run artifacts and figures: committed for reproducibility, but the container
# only needs to *play* the game, not regenerate the report.
results/
figures/
